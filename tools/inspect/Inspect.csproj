<Project Sdk="Microsoft.NET.Sdk">
  <!-- Prints the members of game types, for finding what a mod can read.
       Reflection over sts2.dll's metadata only: no game code is run. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
